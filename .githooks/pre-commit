#!/bin/sh
set -e

file="android/version.properties"
base=2025

if [ ! -f "$file" ]; then
  cur=$base
else
  cur=$(sed -n 's/^versionCode=\([0-9][0-9]*\).*/\1/p' "$file")
  cur=${cur:-$base}
fi

next=$((cur + 1))
echo "versionCode=$next" > "$file"
echo "[pre-commit] auto-increment versionCode: $cur -> $next"
git add "$file"

# Keep pubspec.yaml's build number (`version: X.Y.Z+N`) in lockstep with the
# versionCode just written, so the two can never drift. Single source of truth
# is the version.properties above; never hand-edit the `+N` in pubspec.yaml.
sh scripts/sync-version-code.sh
git add pubspec.yaml
