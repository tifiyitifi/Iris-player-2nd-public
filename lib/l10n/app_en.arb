  "set_resume_on_startup_desc": "Auto-resume last media from last position on app start (metadata mode only; off restores paused state)",
  "set_sync_legacy_blob_desc": "Also mirror every change into the legacy secure-storage blob while metadata mode is ON (rollback safety)",
  "set_metadata_settings_gate_desc": "Store settings as DB rows (experimental, rollback-safe)",
  "set_identity_entries_desc": "Create home-screen shortcuts with a custom icon and name, optionally bound to a scenario + tag",
  "set_auto_resize_desc": "Auto-resize window to video aspect (desktop only; not in fullscreen/maximized; portable build defaults on)",
  "set_playlist_panel_mode_desc": "Side: docked right next to video (draggable 240-600px); Floating: centered popup. Long-press list or button to switch anytime",
  "set_side_fullscreen_behavior_desc": "In picture fullscreen (Enter), keep the side queue docked (Keep panel) or leave it hidden and summon it by hovering the right edge (Hide panel). Window fullscreen and floating mode are unaffected",
  "set_fs_edge_reveal_width": "Fullscreen hover zone width",
  "set_fs_edge_reveal_width_desc": "Width of the right-edge hover strip that reveals the side queue in picture fullscreen, as a percentage of the screen (0-50%; 0 disables hover summoning). Moving the pointer off the panel +5px hides it again",
  "set_fs_isolation_side": "Side panel: isolation zone",
  "set_fs_isolation_side_desc": "Band kept clear for the side-type control panel: isolation height = panel height + this percentage of the screen height. In picture fullscreen, hovering the right edge inside this band does not summon the side queue. Default 5%",
  "set_fs_isolation_linear": "Normal bar: isolation zone",
  "set_fs_isolation_linear_desc": "Band kept clear for the normal long-strip control bar: isolation height = bar height + this percentage of the screen height. In picture fullscreen, hovering the right edge inside this band does not summon the side queue. Default 25%",
  "set_playlist_popup_theme_desc": "Floating queue theme: follow system / dark / light (desktop only)",
  "set_playlist_dock_theme_desc": "Side queue theme: PotPlayer dark / follow system / light (desktop only)",
  "set_scenario_queue_layout_desc": "V1 keeps the classic multi-row toolbar; V2 condenses it into one row and moves the rest into the more menu; V3 removes the bottom bar entirely and floats the controls over the list as a translucent grid of tiles you can drag anywhere. Defaults: V3 in phone landscape, V2 elsewhere. The toolbar button switches at any time",
  "set_video_display_mode_desc": "Video fit: fill/stretch/crop/original (desktop adds auto/force-original; Fit button in control bar switches too)",
