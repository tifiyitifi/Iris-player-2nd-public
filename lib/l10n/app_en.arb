  "set_osd_layout_desc": "Single line or two lines (title + value)",
  "set_osd_duration_desc": "How long the OSD stays on screen",
  "set_keybind_editor_desc": "Only the PotPlayer scheme is editable: up to 4 bindings per action, can clear to unbind; bold blue means customized",
  "set_window_keep_in_bounds_desc": "When playing next video/audio, pull the window back into view if it moved off-screen (desktop only; skipped in fullscreen/maximized)",
  "set_speed_gesture_mode_desc": "Takes effect only after long-press horizontal swipe; horizontal 0.1 fine + vertical 1.0 coarse (dual) / horizontal 0.1 only (single)",
  "set_speed_rate_mode_desc": "Dual wheel, slider, or the legacy flat list",
