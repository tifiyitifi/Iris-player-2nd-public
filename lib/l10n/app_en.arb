  "set_vm_mark_tick_color_desc": "Virtual segment tick color & length (default white 7px; 0px flush with axis)",
  "set_vm_naming_strategy_desc": "Numbering for new/copied rule names (rule+N): maxPlusOne takes max+1 (default, no reuse) / reuseGap reuses smallest gap / globalCounter global increment",
