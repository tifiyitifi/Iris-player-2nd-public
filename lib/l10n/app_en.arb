  "bg_scope_persist_desc": "On: this scope choice is remembered after the app restarts. Off: it applies only to this session.",
  "set_bg_start_armed": "Arm Sub Audio at startup",
  "set_bg_start_armed_desc": "On (default): the app opens with Sub Audio on but stopped — no audio until you press play or a saved pairing starts. Off: Sub Audio stays fully off until you turn it on. Independent of the preload row below.",
  "set_bg_gate_stop_behavior": "Sub Audio button stop behavior",
  "set_bg_gate_stop_behavior_desc": "What the quick-bar stop does. Pause: keeps the media loaded and re-aligns next time. Unload: releases the media and reloads next time. The run state and the ready player always stay.",
  "bg_gate_stop_pause": "Pause media (re-align next time)",
  "bg_gate_stop_unload": "Unload media (reload next time)",
  "set_bg_keep_warm": "Keep a Sub Audio player ready at startup",
  "set_bg_keep_warm_desc": "Preloads for background playback so turning Sub Audio on is instant. Costs one idle player for the whole session.",
  "set_bg_keep_warm_off_notice": "This preload exists to make background playback start instantly. If you rarely use Sub Audio you can turn it off; starting it later will take a moment and may flash.",
  "set_bg_align_default": "Sub Audio alignment default",
  "set_bg_align_default_desc": "The alignment applied whenever a Sub Audio file is aligned. Open the alignment popup for the live update and this default.",
  "set_bg_align_warn": "Ask before the Sub Audio runs out (seconds)",
  "set_bg_align_warn_desc": "Raise the alignment popup when the aligned Sub Audio has less than this many seconds left (default 5, range 1–120). Skipped when the end action keeps playing the next Sub Audio, since that continues automatically.",
  "set_bg_exhausted_action": "When the Sub Audio file ends",
  "set_bg_exhausted_action_desc": "Within a SINGLE video (unrelated to the activation scope): play the next queued Sub Audio, walking the Sub Audio list as a loop so a track is always audible, or pause Sub Audio and restore the video's own audio.",
  "set_bg_queue_sync_mode": "When a tagged video joins the list",
  "set_bg_queue_sync_mode_desc": "The running Sub Audio list is built when Sub Audio starts, so a video tagged afterwards only appears after a rebuild. Rebuilding re-reads the source rules and keeps the playing video in place; appending adds just the new videos to the end and never moves what is queued. Applies only while Sub Audio is running.",
  "set_bg_fg_window_zoom": "APB foreground zoom",
  "set_bg_fg_window_zoom_desc": "When the foreground is much longer than the Sub Audio file, show only this many times the Sub Audio length on the foreground axis, so the A–B mapping does not collapse to a point. 1 disables the zoom (range 1.0–10.0).",
  "set_bg_fg_window_push_bg": "q pushes the Sub Audio mapping",
  "set_bg_fg_window_push_bg_desc": "When the q handle pans the foreground window past the A/B endpoints (12/11 o'clock): Off clamps the pan; On slides the mapping over the fixed Sub Audio window, modifying the alignment.",
  "set_bg_min_segment_span": "Minimum segment length",
  "set_bg_min_segment_span_desc": "How short an A–B mapping segment may be, in milliseconds (default 500, range 100–5000). A drag can never collapse a segment below this.",
  "set_bg_p_align_keep_length": "P keeps the sealed pile",
  "set_bg_p_align_keep_length_desc": "When the P handle leaves a video head/tail it first spends only the pile created by pressing into the boundary: On keeps the pile you bundled in the air and never consumes it; Off lets it be consumed down to nothing.",
  "set_bg_sticky_consume": "Sticky consumption at video ends",
  "set_bg_sticky_consume_desc": "Which handles spend a bundled pile at a video head/tail before the window starts to move. P: pulling P off an end spends the pile there; A/B: dragging A or B outward spends the opposite end's pile once its own is gone. Off moves the window immediately; P only / A-B only restrict it to one handle; All (default) covers both.",
  "bg_sticky_consume_off": "Off",
  "bg_sticky_consume_p_only": "P only",
  "bg_sticky_consume_ab_only": "A/B only",
  "bg_sticky_consume_all": "All",
  "set_bg_segment_guide": "Sub Audio guide",
  "set_bg_segment_guide_desc": "Explains the A / P / B points, the discarded-time readouts, and the minimum segment length.",
  "bg_segment_guide_title": "Sub Audio mapping guide",
  "bg_segment_guide_body": "A — the video position where Sub Audio starts.\nB — the video position where Sub Audio stops (A–B must stay at least the minimum length).\nP — the alignment handle: dragging it moves the whole A–B window, changing which Sub Audio content plays at each video position.\n\n−mm:ss next to A is Sub Audio discarded before A; next to B it is the unused tail after B. These appear when the segment uses less Sub Audio than it could.\n\nWhile A or B has discarded time left, dragging it outward (A left / B right) spends that discard; once it reaches zero, an opposite end already sitting on a video end spends its own unused pile next (see the sticky-consumption setting); only then does the whole window travel. Dragging inward (A right / B left) always discards more.",
  "bg_segment_color_title": "Segment color",
  "bg_segment_color_random": "Random",
  "bg_segment_color": "Label color",
  "set_bg_ratio_explicit_save": "Save the volume ratio explicitly",
  "set_bg_ratio_explicit_save_desc": "On: the ratio dialog only applies on Save. Off: dragging applies immediately and is saved when you let go.",
  "menu_seek_step": "Seek step",
  "bg_seek_link": "Seek linking",
  "bg_seek_linked": "Linked",
  "bg_seek_independent": "Fully independent",
  "bg_lock_level_high": "High (seek step + play/pause)",
  "bg_lock_level_low": "Low (play/pause only)",
  "bg_release_resources": "Fully close Sub Audio (release resources)",
  "bg_reenable_support": "Re-enable Sub Audio support",
  "bg_cross_section": "Cross-video switches",
  "bg_cross_item_title": "Video moves to a new list item",
  "bg_cross_item_desc": "Covers a real media file and a whole virtual-merged item (the merged video counts as ONE item).",
  "bg_cross_segment_title": "Virtual video switches segments (a real file change)",
  "bg_cross_segment_desc": "Inside one virtual-merged item, a segment switch loads a different physical file.",
  "bg_cross_keep_playing": "Keep playing",
  "bg_cross_keep_playing_tiled": "Keep playing (tiled)",
  "bg_cross_new_bg": "Switch to a new bg",
  "set_bg_item_switch": "On a new list item",
  "set_bg_item_switch_desc": "What Sub Audio does when the video moves to a new list item (real media or a whole virtual-merged item): keep playing the current track, or switch to a new bg track",
  "set_bg_segment_switch": "On a virtual video segment switch",
  "set_bg_segment_switch_desc": "What Sub Audio does when a virtual-merged video switches to a different physical segment: keep playing (tiled across the merged file, the Sub Audio list looping continuously) or switch to a new bg track. Whole-video tiling computes the loop layout once per virtual video and plays each segment's matching bg in order; a block with a saved timeline, or a segment you adjusted yourself this launch, replaces only that segment",
  "bg_vm_scope_rule": "Virtual video matching",
  "bg_vm_scope_per_block": "Current segment only",
  "bg_vm_scope_whole": "Whole virtual video",
  "bg_vm_scope_per_block_desc": "Only the block on screen counts as the current video, so every internal block switch is treated as a media switch.",
  "bg_vm_scope_whole_desc": "The whole virtual video counts as ONE video: Sub Audio keeps applying across internal block switches and only stops when you leave for another video. Volume ratios still follow each block. Only the virtual video that was current at the time is treated this way; a later virtual video falls back to per-block, where only blocks with a saved timeline take over.",
  "bg_reactivate_title": "When Sub Audio reopens (this video scope)",
  "bg_reactivate_same": "Same track",
  "bg_reactivate_next": "Next track",
  "bg_reactivate_desc": "After you stop Sub Audio, which track the next open lands on under the \"This video\" scope. \"Next track\" cycles the queue (a single-item list stays on itself).",
  "bg_tiled_manual_title": "Remember this segment's Sub Audio alignment?",
  "bg_tiled_manual_desc": "You switched the Sub Audio track on this segment. Pick how it should start — the choice is kept for this segment until the app restarts; other segments keep the computed tiling.",
  "set_bg_vm_scope_mode": "Virtual video matching (this video scope)",
  "set_bg_vm_scope_mode_desc": "For the \"This video\" scope: match only the block on screen (independent block matching, default), or treat the whole virtual video as one video so Sub Audio keeps playing across its internal blocks. A block with a saved timeline always takes precedence",
  "bg_quick_bar": "Quick controls",
  "bg_auto_control_title": "Sub Audio now owns the controls",
  "bg_auto_control_body": "Sub Audio is on, so the control bar (and keyboard, gestures) now drives the Sub Audio player — its frame is blue. Switch back from the Sub Audio menu.",
  "bg_align_left": "Left",
  "bg_align_right": "Right",
  "dlg_warn_bg_auto_control_title": "Sub Audio control notice",
  "dlg_warn_bg_auto_control_desc": "The first time Sub Audio takes over: explains that the blue-outlined bar drives Sub Audio",
  "dlg_warn_scenario_workspace_title": "Workspace replaced on play",
  "dlg_warn_scenario_workspace_desc": "Before the first folder/selection play: explains that playing replaces the \"Playing\" workspace, and saved scenarios load via Override/Append",
  "dlg_scenario_workspace_body": "What a folder, multi-selection or whole-library play does:\nPlayback runs in the same \"Playing\" workspace; such a play replaces it (sources and explicit items cleared) — it never appends. Saved scenarios are plans: load with Play (Override), or Append from the menu.",
  "dlg_warn_scenario_browse_play_title": "Override current playing?",
  "dlg_warn_scenario_browse_play_desc": "Before the browse page's Play action: warns that it replaces the current playing queue",
  "dlg_warn_tag_grammar_title": "Tag commands",
  "dlg_warn_tag_grammar_desc": "Before the Tag sheet first opens: explains the +n / -n / *n numeric commands",
  "dlg_tag_grammar_body": "Mark files during playback; each tag keeps its own position in the list, while a video's playback progress is the same across all scenarios and tags, not stored separately.\nTags are collections, not folders; numeric commands:\n\n• +n — add the current file to tag n\n• -n — remove it from tag n\n• *n — switch playback to tag n\n• *0 — return to the untagged list\n\nJoin ordinals with a dot (e.g. +1.2). Numbers are the tag positions in this list, pinned first.",
  "dlg_warn_vm_concept_title": "Merged playback",
  "dlg_warn_vm_concept_desc": "Before the first Virtual Media rule: explains that clips are merged into one continuous timeline",
  "dlg_vm_concept_body": "Join multiple videos into one continuous timeline for scrubbing and back-to-back playback.\nA Virtual Media rule matches against the scanned records in the persistent media library (database), joins consecutive matching videos into one timeline at playback time, and plays the real files in order:\n\n• Real files are never modified, moved or joined.\n• Resume follows the actual file watched, so a break lands on the most recent watched part.\n• A group falls back to plain single files when a segment's duration is unknown (shown in yellow, indicating a code bug).",
  "dlg_warn_app_overview_title": "IRIS feature guide",
  "dlg_warn_app_overview_desc": "First-launch feature tour; reopen any time from Settings → About",
  "set_bg_auto_focus": "Hand the controls to Sub Audio on start",
  "set_bg_auto_focus_desc": "When Sub Audio starts, the control bar, shortcuts and gestures drive it instead of the video (marked by a blue frame). Turn off to keep controlling the video",
  "set_bg_seek_link": "Seek linking",
  "set_bg_seek_link_desc": "Linked: a seek on either side moves the pair together. Fully independent: the two players never influence each other",
  "set_bg_use_saved_mapping": "Auto-use saved mappings",
  "set_bg_use_saved_mapping_desc": "On (default): a video with a saved Sub Audio timeline plays it automatically. Off: saved timelines are ignored and Sub Audio plays its own queue",
  "set_bg_lock_level": "Progress lock level",
  "set_bg_lock_level_desc": "High: fast-forward/rewind step and play/pause both mirror the video. Low: only play/pause mirrors. Has no effect while Seek linking is Fully independent",
  "set_bg_align_ring": "Align editor ring assignment",
  "set_bg_align_ring_desc": "Which ring drives the foreground video in the side-type align editor; the Sub Audio ring takes the other one",
  "set_bg_quick_bar": "Quick controls",
  "set_bg_quick_bar_desc": "Shows a Sub Audio control strip beside the side panel, or a row inside the bottom bar. It carries only Sub Audio-specific actions (control/picture switching, volume ratio, timeline mapping, closing)",
  "set_bg_quick_bar_align": "Quick controls alignment",
  "set_bg_quick_bar_align_desc": "Where the quick-control row sits inside the bottom bar (the side panel always snaps the strip to the screen-centre edge)",
  "set_bg_follow_fg": "Follow foreground switching",
  "set_bg_follow_fg_desc": "When the foreground switches to another video, re-resolve that video's Sub Audio mapping at the new position (off by default — Sub Audio never stops or restarts just because the foreground changed)",
  "set_bg_rate_lock": "Lock speed to foreground",
  "set_bg_rate_lock_desc": "Natural Sub Audio playback runs at the same speed as the foreground video (on by default). Mapped segments use their own alignment speed regardless",
  "set_bg_allow_same_file": "Allow same file in both players",
  "set_bg_allow_same_file_desc": "Lets the same physical video play in the foreground and as Sub Audio at once (off by default — the same file is skipped in the Sub Audio queue)",
  "set_bg_video_layout": "Sub picture layout",
